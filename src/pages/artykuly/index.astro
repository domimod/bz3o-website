---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = (await getCollection('articles', ({data}) => data.language==='pl' && data.draft!==true)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Artykuły o Bagua Zhang | BZ3O" description="Artykuły szkoły BZ3O o Bagua Zhang, treningu, historii, mobilności i wewnętrznych stylach chińskich sztuk walki.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Wiedza BZ3O</p><h1 class="page-title">Artykuły o Bagua Zhang</h1><p class="lead intro">Historia, metody treningowe, sposób ruchu i praktyczne spojrzenie na wewnętrzne style chińskich sztuk walki.</p>
      {posts.length ? <div class="posts">{posts.map(post=><article class="card"><p class="eyebrow">{post.data.tags[0]??'Bagua Zhang'}</p><h2>{post.data.title}</h2><p>{post.data.description}</p><a class="link-arrow" href={`/artykuly/${post.id}/`}>Czytaj →</a></article>)}</div> : <div class="empty card"><h2>Artykuły są w przygotowaniu</h2><p>Pierwsze materiały zostaną opublikowane wkrótce.</p><a class="button button--secondary" href="/">Wróć na stronę główną</a></div>}
      <!-- Pliki Markdown w katalogu <code>src/content/articles</code> są już gotowe jako szkielety. -->
    </div>
  </section>
</BaseLayout>
<style>
  .page-title{margin-top:.4rem}.intro{margin-top:1rem}.posts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.posts article{padding:1.5rem}.posts h2{font-size:1.7rem;margin:.45rem 0 .7rem}.posts article>p:not(.eyebrow){color:var(--color-text-muted);margin-bottom:1rem}.empty{max-width:760px;margin-top:3rem;padding:2rem}.empty h2{font-size:2rem}.empty p{margin:1rem 0 1.5rem;color:var(--color-text-muted)}@media(max-width:800px){.posts{grid-template-columns:1fr}}
</style>
