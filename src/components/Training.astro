---
import SectionHeader from './SectionHeader.astro';
import ResponsiveImage from './ResponsiveImage.astro';
const steps = [
  ['01','Przygotowanie ciała','Rozgrzewka, mobilność oraz rozciąganie dynamiczne i statyczne.'],
  ['02','Ji Ben Gong','Ćwiczenia podstawowe rozwijające rozluźnienie, sprężystość, mobilność i koordynację całego ciała.'],
  ['03','Praca nóg','Tan Tui, Tang Ni Bu oraz kroki Kou Bu i Bai Bu.'],
  ['04','Podstawowe dłonie','Osiem Dłoni-Matek (8 Mother Palms), ustawienie ciała i połączenie pracy rąk z ruchem tułowia.'],
  ['05','Zmiany','Pojedyncze i podwójne zmiany dłoni.'],
  ['06','Ćwiczenia w parach','Kontakt, wyczucie kierunku siły i praktyczne zastosowania technik.']
];
---
<section id="trening" class="section section--white">
  <div class="container">
    <SectionHeader eyebrow="Od podstaw do zastosowań" title="Jak wygląda trening?" lead="Zajęcia prowadzą stopniowo od przygotowania ciała i podstawowego sposobu poruszania się do bardziej złożonych zmian, pracy w parach i zastosowań technik." />
    <div class="training-layout">
      <ol class="timeline">
        {steps.map(([n,title,text]) => <li><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}
      </ol>
      <div class="training-media">
        <ResponsiveImage base="training-kou-bu" alt="Ćwiczenie pozycji i pracy nóg w treningu Bagua Zhang" aspect="4 / 3" widths={[640,960,1440]} sizes="(max-width: 850px) 50vw, 40vw" />
        <ResponsiveImage base="training-partner" alt="Ćwiczenie Bagua Zhang w parze – praktyczne zastosowanie techniki" aspect="4 / 3" widths={[640,960,1440]} sizes="(max-width: 850px) 50vw, 40vw" />
      </div>
    </div>
    <div class="beginner-callout"><strong>Nie potrzebujesz wcześniejszego doświadczenia w sztukach walki.</strong><span>Zaczynamy od podstaw i rozwijamy umiejętności stopniowo.</span></div>
  </div>
</section>
<style>
  .training-layout{
    display:grid;
    grid-template-columns:1fr .9fr;
    gap:clamp(2rem,5vw,5rem);
  }

  .timeline{
    list-style:none;
    display:grid;
  }

  .timeline li{
    display:grid;
    grid-template-columns:58px 1fr;
    gap:1rem;
    padding:1.15rem 0;
    border-bottom:1px solid var(--color-border);
  }

  .timeline li>span{
    width:44px;
    height:44px;
    display:grid;
    place-items:center;
    border:1px solid var(--color-gold);
    border-radius:50%;
    font-family:var(--font-heading);
    color:var(--color-gold-dark);
  }

  .timeline p{
    margin-top:.35rem;
    color:var(--color-text-muted);
  }

  .training-media{
    display:grid;
    gap:1rem;
    align-content:start;
  }

  .training-media :global(.responsive-image),
  .training-media :global(picture),
  .training-media :global(img){
    border-radius:20px;
  }

  .training-media :global(.responsive-image),
  .training-media :global(picture){
    overflow:hidden;
  }

  .training-media :global(img){
    display:block;
  }

  .beginner-callout{
    margin-top:2.5rem;
    display:flex;
    gap:.8rem 1.5rem;
    flex-wrap:wrap;
    align-items:center;
    padding:1.25rem 1.4rem;
    border-left:3px solid var(--color-seal);
    background:var(--color-surface-soft);
  }

  .beginner-callout span{
    color:var(--color-text-muted);
  }

  @media(max-width:850px){
    .training-layout{
      grid-template-columns:1fr;
    }

    .training-media{
      grid-template-columns:1fr 1fr;
    }
  }

  @media(max-width:600px){
    .training-media{
      grid-template-columns:1fr;
    }
  }
</style>
