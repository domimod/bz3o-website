---
interface Props {
  label: string;
  detail?: string;
  aspect?: string;
  dark?: boolean;
}
const { label, detail, aspect = '4 / 3', dark = false } = Astro.props;
---
<div class:list={['media-placeholder', { dark }]} style={`--aspect:${aspect}`} role="img" aria-label={`${label}${detail ? ` – ${detail}` : ''}`}>
  <div class="circles" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="copy">
    <span>PLACEHOLDER</span>
    <strong>{label}</strong>
    {detail && <small>{detail}</small>}
  </div>
</div>

<style>
  .media-placeholder {
    position: relative; overflow: hidden; isolation: isolate;
    aspect-ratio: var(--aspect); min-height: 240px;
    border: 1px dashed var(--color-warm-gray); border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #f4f1ea, #ece6db);
    display: grid; place-items: center; padding: 1.5rem; text-align: center;
  }
  .dark { background: #292725; border-color: #655f56; color: var(--color-ivory); }
  .circles { position: absolute; inset: 10% 12%; z-index: -1; opacity: .28; }
  .circles i { position:absolute; inset:50%; border-radius:50%; transform:translate(-50%,-50%); border: 2px solid var(--color-ink); }
  .circles i:nth-child(1){ width:75%; aspect-ratio:1; }
  .circles i:nth-child(2){ width:55%; aspect-ratio:1; border-color:var(--color-gold); }
  .circles i:nth-child(3){ width:35%; aspect-ratio:1; border-color:var(--color-warm-gray); }
  .copy { display:grid; gap:.35rem; max-width: 320px; }
  .copy span { font-size:.68rem; letter-spacing:.16em; font-weight:800; color:var(--color-gold-dark); }
  .copy strong { font-family:var(--font-heading); font-size:1.5rem; }
  .copy small { color:var(--color-text-muted); line-height:1.5; }
  .dark .copy small { color:#cfc8bb; }
</style>
