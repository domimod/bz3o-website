---
import LogoMark from "./LogoMark.astro";
import { siteConfig, navigation } from "../config/site";
const socials = Object.entries(siteConfig.social).filter(([, url]) =>
  Boolean(url),
);
const whatsapp = siteConfig.whatsappNumber
  ? `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g, "")}`
  : "";
const tel = siteConfig.phone
  ? `tel:${siteConfig.phone.replace(/\s/g, "")}`
  : "";
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="brand">
      <LogoMark inverse /><p>{siteConfig.internationalName}</p><strong
        >{siteConfig.name}</strong>
    </div>
    <div>
      <h2>Nawigacja</h2><nav>
        {
          navigation
            .slice(0, 6)
            .map((item) => <a href={item.href}>{item.label}</a>)
        }<a href="/artykuly/">Artykuły</a>
      </nav>
    </div>
    <div>
      <h2>Kontakt</h2>

      <a href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
      </a>

      {tel && <a href={tel}>{siteConfig.phone}</a>}

      {
        whatsapp && (
          <a
            class="whatsapp-link"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp →
          </a>
        )
      }
      {socials.length > 0 && (
        <div class="socials">
          {socials.map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {name === 'facebook'
                ? 'Facebook'
                : name === 'instagram'
                  ? 'Instagram'
                  : name === 'youtube'
                    ? 'YouTube'
                    : name}
            </a>
          ))}
        </div>
      )}
    </div>
    <div>
      <h2>Informacje</h2><a href="/polityka-prywatnosci/"
        >Polityka prywatności</a
      ><a href={siteConfig.location.mapsUrl} target="_blank" rel="noopener"
        >Lokalizacja</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© 2026 {siteConfig.name}</span><span>BZ3O</span>
  </div>
</footer>
<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-ivory);
    padding: 3rem 0 1.4rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 0.9fr 0.9fr;
    gap: 2rem;
  }
  .brand p {
    margin-top: 1rem;
    color: #c8c0b5;
    font-family: var(--font-heading);
  }
  .brand > strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: #938b81;
  }
  .footer h2 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: #c8aa6d;
    margin-bottom: 0.8rem;
  }
  .footer nav,
  .footer-grid > div:not(.brand) {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .footer a {
    color: #d7d0c5;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .footer a:hover {
    color: #e4c47f;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid #3d3935;
    color: #8f887f;
    font-size: 0.72rem;
  }
  .whatsapp-link {
    color: #c8aa6d !important;
    font-weight: 700;
  }

  .whatsapp-link:hover {
    color: #e4c47f !important;
  }  
  @media (max-width: 850px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      display: grid;
      gap: 0.4rem;
    }
  }
</style>
