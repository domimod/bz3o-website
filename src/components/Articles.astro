---
import { getCollection } from 'astro:content';
import SectionHeader from './SectionHeader.astro';
import ResponsiveImage from './ResponsiveImage.astro';

const published = (
  await getCollection(
    'articles',
    ({ data }) =>
      data.language === 'pl' &&
      data.draft !== true
  )
)
  .sort(
    (a, b) =>
      b.data.date.valueOf() -
      a.data.date.valueOf()
  )
  .slice(0, 3);

const planned = [
  [
    'Historia Bagua Zhang',
    'Krótki przewodnik po początkach Bagua Zhang i najważniejszych liniach przekazu.',
    'article-history',
    'Trening Bagua w otoczeniu tradycyjnej chińskiej architektury'
  ],
  [
    'Bagua Zhang a Tai Chi – czym się różnią?',
    'Porównanie sposobu poruszania się, pracy ciała i charakteru treningu.',
    'article-bagua-vs-taichi',
    'Pozycja z treningu wewnętrznych stylów chińskich sztuk walki'
  ],
  [
    'Korzyści z treningu Bagua Zhang',
    'Jak poszczególne elementy treningu przekładają się na mobilność, równowagę i koordynację.',
    'article-benefits',
    'Ćwiczenie mobilności i pozycji w Bagua Zhang'
  ]
];
---

<section id="artykuly" class="section section--white">
  <div class="container">

    <SectionHeader
      eyebrow="Wiedza"
      title="Artykuły o Bagua Zhang"
      lead="Materiały o treningu, historii, metodach ruchu oraz wewnętrznych stylach chińskich sztuk walki."
    />

    <div class="article-grid">
      {
        published.length > 0
          ? published.map((post) => (
              <article class="article-card card">

                <div class="article-image article-image--placeholder">
                  <span>ARTYKUŁ</span>
                </div>

                <div class="article-copy">
                  <p class="eyebrow">
                    {post.data.tags[0] ?? 'Bagua Zhang'}
                  </p>

                  <h3>{post.data.title}</h3>

                  <p>{post.data.description}</p>

                  <a
                    class="link-arrow"
                    href={`/artykuly/${post.id}/`}
                  >
                    Czytaj →
                  </a>
                </div>

              </article>
            ))
          : planned.map(([title, description, image, alt]) => (
              <article class="article-card card">

                <div class="article-image">
                  <ResponsiveImage
                    base={image}
                    alt={alt}
                    aspect="16 / 9"
                    widths={[640, 960, 1440]}
                    sizes="(max-width: 550px) 100vw, (max-width: 850px) 210px, 33vw"
                  />
                </div>

                <div class="article-copy">
                  <p class="eyebrow">
                    Planowany artykuł
                  </p>

                  <h3>{title}</h3>

                  <p>{description}</p>

                  <span class="coming">
                    Artykuł zostanie opublikowany wkrótce.
                  </span>
                </div>

              </article>
            ))
      }
    </div>

    <p class="all">
      <a class="link-arrow" href="/artykuly/">
        Wszystkie artykuły →
      </a>
    </p>

  </div>
</section>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-card {
    overflow: hidden;
    min-width: 0;
  }

  /*
   * Kontener zdjęcia zawsze ma kontrolowane proporcje.
   */
  .article-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #ede7dc;
  }

  /*
   * ResponsiveImage generuje wewnętrzny picture/img.
   * Wymuszamy ich dopasowanie do kontenera.
   */
  .article-image :global(.responsive-image),
  .article-image :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .article-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;

    object-fit: cover;
    object-position: center;

    border-radius: 0;
  }

  .article-image--placeholder {
    display: grid;
    place-items: center;
  }

  .article-copy {
    padding: 1.3rem;
  }

  .article-copy h3 {
    margin: 0.4rem 0 0.6rem;
  }

  .article-copy > p:not(.eyebrow) {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .coming {
    font-size: 0.78rem;
    color: #938b82;
  }

  .all {
    margin-top: 1.7rem;
  }

  /*
   * Tablet / mały desktop:
   * zdjęcie po lewej, tekst po prawej.
   */
  @media (max-width: 850px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-card {
      display: grid;
      grid-template-columns: 210px minmax(0, 1fr);
    }

    .article-image {
      height: 100%;
      min-height: 180px;
      aspect-ratio: auto;
    }
  }

  /*
   * Telefon:
   * zdjęcie wraca nad tekst i ma prawdziwe 16:9.
   */
  @media (max-width: 550px) {
    .article-card {
      display: block;
    }

    .article-image {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .article-image :global(.responsive-image),
    .article-image :global(picture),
    .article-image :global(img) {
      width: 100%;
      height: 100%;
    }

    .article-copy {
      padding: 1.15rem;
    }
  }
</style>
