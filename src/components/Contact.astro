---
import { siteConfig } from '../config/site';
const whatsapp = siteConfig.whatsappNumber ? `https://wa.me/${siteConfig.whatsappNumber.replace(/\D/g,'')}` : '';
const tel = siteConfig.phone ? `tel:${siteConfig.phone.replace(/\s/g,'')}` : '';
---
<section id="kontakt" class="section section--ink contact">
  <div class="container contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">Pierwszy trening bezpłatny</p>
      <h2>Przyjdź i spróbuj Bagua Zhang</h2>
      <p>Jeśli chcesz dołączyć do zajęć, napisz lub zadzwoń i daj znać, że planujesz przyjść. Nie jest potrzebne wcześniejsze doświadczenie w sztukach walki.</p>
      <div class="actions">
        {whatsapp && <a class="button button--gold" href={whatsapp} target="_blank" rel="noopener">Napisz na WhatsApp</a>}
        <a class="button contact-secondary" href={`mailto:${siteConfig.email}`}>Napisz e-mail</a>
        {tel && <a class="button contact-secondary" href={tel}>Zadzwoń</a>}
      </div>
      {!whatsapp && <p class="pending">WhatsApp Business zostanie dodany po uruchomieniu numeru szkoły.</p>}
    </div>
    <div class="first-visit">
      <h3>Na pierwszy trening zabierz</h3>
      <ul><li>luźny strój sportowy, np. dres,</li><li>wygodne obuwie na niskiej podeszwie,</li><li>wodę.</li></ul>
      <div class="contact-data"><span>E-mail</span><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><span>Zajęcia</span><strong>Środy · 19:30–21:00 · Kraków</strong></div>
    </div>
  </div>
</section>
<style>
  .contact{border-bottom:1px solid #3a3734}.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,6vw,6rem);align-items:center}.contact-copy{display:grid;gap:1.1rem}.contact-copy h2{max-width:650px}.contact-copy>p:not(.eyebrow){max-width:660px;color:#d7d0c5}.actions{display:flex;flex-wrap:wrap;gap:.7rem}.contact-secondary{border:1px solid #80766a;color:var(--color-ivory)}.contact-secondary:hover{border-color:var(--color-gold);color:var(--color-ivory);background:#282624}.pending{font-size:.8rem!important;color:#ada59a!important}.first-visit{padding:1.7rem;border:1px solid #48433e;border-radius:var(--radius-md);background:#242321}.first-visit h3{margin-bottom:.8rem}.first-visit ul{padding-left:1.1rem;color:#d7d0c5}.contact-data{display:grid;gap:.25rem;margin-top:1.3rem;padding-top:1.2rem;border-top:1px solid #48433e}.contact-data span{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:#c8aa6d;margin-top:.5rem}.contact-data a,.contact-data strong{font-size:.9rem;color:#f2eee7}@media(max-width:800px){.contact-grid{grid-template-columns:1fr}}
</style>
