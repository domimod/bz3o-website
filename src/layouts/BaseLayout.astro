---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Bagua Zhang Kraków | Szkoła Trzech Okręgów – BZ3O',
  description = 'Szkoła Bagua Zhang w Krakowie. Tradycyjny Cheng Baguazhang rozwijający mobilność, równowagę, koordynację i koncentrację. Pierwszy trening bezpłatny.',
  image = '/og/bz3o-og.png',
  canonical,
  type = 'website',
  schema
} = Astro.props;

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: siteConfig.name,
  alternateName: [siteConfig.shortName, 'San Yuan Baguazhang'],
  description,
  url: siteConfig.url,
  email: siteConfig.email,
  sport: 'Baguazhang',
  priceRange: '150 PLN / miesiąc',
  openingHours: 'We 19:30-21:00',
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.location.street,
    postalCode: siteConfig.location.postalCode,
    addressLocality: siteConfig.location.city,
    addressCountry: 'PL'
  }
};
const jsonLd = schema ?? defaultSchema;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F9F8F6" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
